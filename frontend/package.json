{
  "name": "meal-planner-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "uv run --project .. python ../tools/dump_openapi.py > openapi.json && npm run gen:types",
    "gen:types": "openapi-typescript openapi.json -o src/api-types.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run gen:types && tsc --noEmit && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
